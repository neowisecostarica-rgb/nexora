{
  "name": "CostComponentDefinitions",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organización propietaria. Requerido para multi-tenancy."
    },
    "key": {
      "type": "string",
      "description": "Clave técnica única e inmutable del tipo de costo (ej. import_freight, repair_fee, customs_duty). NO modificar una vez creado."
    },
    "label": {
      "type": "string",
      "description": "Etiqueta legible para la UI (ej. Flete de Importación, Tarifa de Reparación)."
    },
    "description": {
      "type": "string",
      "description": "Descripción extendida del tipo de costo para el administrador."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si false, este tipo de costo es ignorado por el motor de costos."
    }
  },
  "required": [
    "organization_id",
    "key",
    "label",
    "is_active"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}
