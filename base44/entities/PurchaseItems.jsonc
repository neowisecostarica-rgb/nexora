{
  "name": "PurchaseItems",
  "type": "object",
  "properties": {
    "purchase_order_id": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "line_family": {
      "type": "string"
    },
    "cpu": {
      "type": "string"
    },
    "ram_gb": {
      "type": "number"
    },
    "storage_type": {
      "type": "string",
      "enum": [
        "SSD",
        "HDD",
        "eMMC",
        "NVMe"
      ]
    },
    "storage_gb": {
      "type": "number"
    },
    "screen_size": {
      "type": "string"
    },
    "screen_type": {
      "type": "string"
    },
    "form_factor": {
      "type": "string",
      "enum": [
        "clamshell",
        "2-in-1",
        "tablet",
        "rugged"
      ]
    },
    "condition_grade": {
      "type": "string",
      "enum": [
        "A+",
        "A",
        "B+",
        "B",
        "C",
        "D",
        "parts"
      ]
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "item_subtotal": {
      "type": "number",
      "default": 0
    },
    "allocated_order_total": {
      "type": "number",
      "default": 0
    },
    "estimated_unit_cost_from_order_total": {
      "type": "number",
      "default": 0
    },
    "inventory_generated_count": {
      "type": "number",
      "default": 0,
      "description": "N\u00famero de InventoryUnits ya generadas. No usar booleano."
    },
    "conversion_in_progress": {
      "type": "boolean",
      "default": false,
      "description": "Lock l\u00f3gico. True mientras hay conversi\u00f3n en curso."
    },
    "notes": {
      "type": "string"
    },
    "product_definition_id": {
      "type": "string",
      "description": "[M1 Cat\u00e1logo Sat\u00e9lite] Referencia opcional a ProductDefinition. No afecta motor de costos ni pricing."
    },
    "product_variant_id": {
      "type": "string",
      "description": "[M1 Cat\u00e1logo Sat\u00e9lite] Referencia opcional a ProductVariant. No afecta motor de costos ni pricing."
    }
  },
  "required": [
    "purchase_order_id",
    "brand",
    "model",
    "quantity"
  ]
}