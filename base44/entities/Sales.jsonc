{
  "name": "Sales",
  "type": "object",
  "properties": {
    "sale_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "channel": {
      "type": "string",
      "enum": [
        "retail",
        "wholesale",
        "promo",
        "marketplace"
      ]
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "transfer",
        "card",
        "credit",
        "other"
      ]
    },
    "invoice_required": {
      "type": "boolean",
      "default": false
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount_total": {
      "type": "number",
      "default": 0
    },
    "tax_total": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "cogs_total": {
      "type": "number",
      "default": 0
    },
    "gross_profit_total": {
      "type": "number",
      "default": 0
    },
    "gross_margin_percent": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    }
  },
  "required": [
    "sale_number",
    "customer_id",
    "sale_date"
  ]
}