{
  "name": "Sales",
  "type": "object",
  "properties": {
    "sale_number": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "channel": {
      "type": "string",
      "enum": [
        "retail",
        "wholesale",
        "promo",
        "marketplace"
      ]
    },
    "sale_type": {
      "type": "string",
      "enum": [
        "retail",
        "wholesale",
        "reseller",
        "internal"
      ],
      "default": "retail"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "transfer",
        "card",
        "credit",
        "other"
      ]
    },
    "invoice_required": {
      "type": "boolean",
      "default": false
    },
    "external_invoice_reference": {
      "type": "string"
    },
    "external_invoice_status": {
      "type": "string",
      "enum": [
        "none",
        "pending",
        "issued"
      ],
      "default": "none"
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount_total": {
      "type": "number",
      "default": 0
    },
    "tax_total": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "cogs_total": {
      "type": "number",
      "default": 0
    },
    "gross_profit_total": {
      "type": "number",
      "default": 0
    },
    "gross_margin_percent": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "cancelled",
        "refunded"
      ],
      "default": "pending"
    },
    "sale_notes_snapshot": {
      "type": "string"
    },
    "organization_profile_snapshot": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number"
        },
        "commercial_name": {
          "type": "string"
        },
        "legal_name": {
          "type": "string"
        },
        "logo_url": {
          "type": "string"
        },
        "phone_main": {
          "type": "string"
        },
        "email_main": {
          "type": "string"
        },
        "address_line": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "payment_instructions": {
          "type": "string"
        },
        "bank_details": {
          "type": "string"
        },
        "sinpe_details": {
          "type": "string"
        },
        "default_terms_conditions": {
          "type": "string"
        }
      }
    }
  },
  "required": [
    "sale_number",
    "customer_id",
    "sale_date"
  ]
}