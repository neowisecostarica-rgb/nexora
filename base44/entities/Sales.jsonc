{
  "name": "Sales",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "customer_phone": {
      "type": "string",
      "description": "Teléfono del cliente"
    },
    "customer_email": {
      "type": "string",
      "description": "Email del cliente (opcional)"
    },
    "channel": {
      "type": "string",
      "enum": [
        "retail",
        "wholesale",
        "marketplace",
        "direct"
      ],
      "description": "Canal de venta"
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "description": "Subtotal antes de descuentos e impuestos"
    },
    "discount_total": {
      "type": "number",
      "default": 0,
      "description": "Total de descuentos aplicados"
    },
    "tax_total": {
      "type": "number",
      "default": 0,
      "description": "Total de impuestos aplicados"
    },
    "total": {
      "type": "number",
      "default": 0,
      "description": "Total final de la venta. SOT del monto."
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales sobre la venta"
    },
    "organization_id": {
      "type": "string",
      "description": "ID de OrganizationProfile propietaria. Campo opcional durante transición; registros sin asignación requieren revisión, no inferir dueño."
    },
    "sale_number": {
      "type": "string"
    },
    "sale_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed",
        "cancelled",
        "refunded"
      ]
    },
    "sale_type": {
      "type": "string"
    },
    "quote_id": {
      "type": "string"
    },
    "customer_id": {
      "type": "string"
    },
    "cogs_total": {
      "type": "number"
    },
    "gross_profit_total": {
      "type": "number"
    },
    "gross_margin_percent": {
      "type": "number"
    },
    "sale_notes_snapshot": {
      "type": "string"
    },
    "organization_profile_snapshot": {
      "type": "object"
    },
    "external_invoice_status": {
      "type": "string"
    },
    "external_invoice_reference": {
      "type": "string"
    },
    "currency": {
      "type": "string",
      "enum": [
        "USD",
        "CRC"
      ],
      "description": "Moneda del documento. No implica conversión FX; requerido para conciliar pagos, opcional para datos legacy."
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "channel",
    "total"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}
