{
  "name": "Sales",
  "type": "object",
  "properties": {
    "customer_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "customer_phone": {
      "type": "string",
      "description": "Tel\u00e9fono del cliente"
    },
    "customer_email": {
      "type": "string",
      "description": "Email del cliente (opcional)"
    },
    "channel": {
      "type": "string",
      "enum": [
        "retail",
        "wholesale",
        "marketplace",
        "direct"
      ],
      "description": "Canal de venta"
    },
    "subtotal": {
      "type": "number",
      "default": 0,
      "description": "Subtotal antes de descuentos e impuestos"
    },
    "discount_total": {
      "type": "number",
      "default": 0,
      "description": "Total de descuentos aplicados"
    },
    "tax_total": {
      "type": "number",
      "default": 0,
      "description": "Total de impuestos aplicados"
    },
    "total": {
      "type": "number",
      "default": 0,
      "description": "Total final de la venta. SOT del monto."
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales sobre la venta"
    }
  },
  "required": [
    "customer_name",
    "customer_phone",
    "channel",
    "total"
  ]
}