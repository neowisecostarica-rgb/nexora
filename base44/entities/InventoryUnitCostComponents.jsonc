{
  "name": "InventoryUnitCostComponents",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organización propietaria. Requerido para multi-tenancy."
    },
    "inventory_unit_id": {
      "type": "string",
      "description": "Referencia lógica a InventoryUnits.id. Convención Base44, sin FK estricta."
    },
    "cost_component_key": {
      "type": "string",
      "description": "Referencia lógica a CostComponentDefinitions.key. Identifica el tipo de costo de este componente."
    },
    "amount": {
      "type": "number",
      "default": 0,
      "description": "Monto asignado a esta unidad para este componente de costo. Siempre positivo."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Contexto adicional del componente. Puede incluir source_type (purchase, import, expense), source_id (ID de la entidad origen), y notas de cálculo.",
      "properties": {
        "source_type": {
          "type": "string",
          "description": "Tipo de entidad origen del costo (ej. ImportBatch, Expense, PurchaseOrder)."
        },
        "source_id": {
          "type": "string",
          "description": "ID de la entidad origen específica."
        },
        "notes": {
          "type": "string",
          "description": "Notas adicionales sobre el cálculo o asignación de este componente."
        }
      }
    }
  },
  "required": [
    "organization_id",
    "inventory_unit_id",
    "cost_component_key",
    "amount"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}
