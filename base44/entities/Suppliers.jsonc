{
  "name": "Suppliers",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Supplier name"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "ebay",
        "local_supplier",
        "distributor",
        "other"
      ],
      "description": "Source type"
    },
    "contact_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "organization_id": {
      "type": "string",
      "description": "ID de OrganizationProfile propietaria. Campo opcional durante transición; registros sin asignación requieren revisión, no inferir dueño."
    }
  },
  "required": [
    "name",
    "source_type"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}
