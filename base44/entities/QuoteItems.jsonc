{
  "name": "QuoteItems",
  "type": "object",
  "properties": {
    "quote_id": {
      "type": "string"
    },
    "inventory_unit_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_price": {
      "type": "number",
      "default": 0
    },
    "discount": {
      "type": "number",
      "default": 0
    },
    "line_total": {
      "type": "number",
      "default": 0
    },
    "organization_id": {
      "type": "string",
      "description": "ID de OrganizationProfile propietaria. Campo opcional durante transición; registros sin asignación requieren revisión, no inferir dueño."
    }
  },
  "required": [
    "quote_id",
    "description",
    "quantity",
    "unit_price"
  ]
}
