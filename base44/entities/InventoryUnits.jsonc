{
  "name": "InventoryUnits",
  "type": "object",
  "properties": {
    "purchase_item_id": {
      "type": "string",
      "description": "Referencia al PurchaseItem de origen"
    },
    "import_batch_id": {
      "type": "string",
      "description": "Referencia al ImportBatch de origen"
    },
    "category_key": {
      "type": "string",
      "description": "Clave de categor\u00eda del producto (ej. laptops, sneakers, smartphones)"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "sold",
        "inactive"
      ],
      "default": "available",
      "description": "Estado del ciclo de vida de la unidad"
    },
    "condition": {
      "type": "string",
      "description": "Condici\u00f3n/grado del producto (ej. A, B, C, A+)"
    },
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n f\u00edsica en almac\u00e9n"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true,
      "description": "Atributos espec\u00edficos por categor\u00eda en formato JSON"
    },
    "normalized_display_name": {
      "type": "string",
      "description": "Nombre generado autom\u00e1ticamente por buildDisplayName. NO editar manualmente."
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de im\u00e1genes del producto"
    },
    "main_image": {
      "type": "string",
      "description": "URL de la imagen principal"
    },
    "legacy_real_unit_cost": {
      "type": "number",
      "default": 0,
      "description": "Campo original real_unit_cost \u2014 renombrado para compatibilidad. NO usar para nuevos c\u00e1lculos."
    },
    "cost_purchase_unit": {
      "type": "number",
      "default": 0,
      "description": "Costo directo de compra de la unidad (sin gastos adicionales)"
    },
    "allocated_import_cost": {
      "type": "number",
      "default": 0,
      "description": "Costo de importaci\u00f3n (customs + freight + local_transport + extra) asignado proporcionalmente a esta unidad"
    },
    "allocated_tax_cost": {
      "type": "number",
      "default": 0,
      "description": "Impuestos de la orden de compra (usa_tax) asignados proporcionalmente a esta unidad"
    },
    "allocated_local_cost": {
      "type": "number",
      "default": 0,
      "description": "Gastos locales (Expenses tipo local) asignados a esta unidad"
    },
    "allocated_repair_cost": {
      "type": "number",
      "default": 0,
      "description": "Gastos de reparaci\u00f3n (Expenses tipo repair) asignados directamente a esta unidad"
    },
    "allocated_other_cost": {
      "type": "number",
      "default": 0,
      "description": "Otros costos asignados a esta unidad (ej. shipping USA)"
    },
    "total_real_unit_cost": {
      "type": "number",
      "default": 0,
      "description": "Costo real total consolidado. SOT del costo. Suma de todos los costos asignados."
    },
    "assigned_pricing_profile_id": {
      "type": "string",
      "description": "Override de perfil de precios espec\u00edfico para esta unidad"
    },
    "retail_price": {
      "type": "number",
      "default": 0,
      "description": "Precio retail calculado por PricingEngine. SOLO LECTURA."
    },
    "wholesale_price": {
      "type": "number",
      "default": 0,
      "description": "Precio mayorista calculado por PricingEngine. SOLO LECTURA."
    },
    "minimum_price": {
      "type": "number",
      "default": 0,
      "description": "Precio m\u00ednimo calculado por PricingEngine. SOLO LECTURA."
    },
    "margin_percent": {
      "type": "number",
      "default": 0,
      "description": "Margen % calculado por PricingEngine. SOLO LECTURA."
    }
  },
  "required": [
    "category_key",
    "status",
    "total_real_unit_cost"
  ]
}