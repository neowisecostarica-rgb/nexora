{
  "name": "InventoryUnits",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organización propietaria. Requerido para multi-tenancy y para el motor de costos."
    },
    "purchase_item_id": {
      "type": "string",
      "description": "Referencia al PurchaseItem de origen"
    },
    "import_batch_id": {
      "type": "string",
      "description": "Referencia al ImportBatch de origen"
    },
    "category_key": {
      "type": "string",
      "description": "Clave de categoría del producto (ej. laptops, sneakers, smartphones)"
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "sold",
        "inactive"
      ],
      "default": "available",
      "description": "Estado del ciclo de vida de la unidad"
    },
    "condition": {
      "type": "string",
      "description": "Condición/grado del producto (ej. A, B, C, A+)"
    },
    "location": {
      "type": "string",
      "description": "Ubicación física en almacén"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": true,
      "description": "Atributos específicos por categoría en formato JSON"
    },
    "normalized_display_name": {
      "type": "string",
      "description": "Nombre generado automáticamente por buildDisplayName. NO editar manualmente."
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de imágenes del producto"
    },
    "main_image": {
      "type": "string",
      "description": "URL de la imagen principal"
    },
    "legacy_real_unit_cost": {
      "type": "number",
      "default": 0,
      "description": "Campo original real_unit_cost — renombrado para compatibilidad. NO usar para nuevos cálculos."
    },
    "cost_purchase_unit": {
      "type": "number",
      "default": 0,
      "description": "Costo directo de compra de la unidad (sin gastos adicionales)"
    },
    "allocated_import_cost": {
      "type": "number",
      "default": 0,
      "description": "Costo de importación asignado proporcionalmente a esta unidad"
    },
    "allocated_tax_cost": {
      "type": "number",
      "default": 0,
      "description": "Impuestos de la orden de compra asignados proporcionalmente a esta unidad"
    },
    "allocated_local_cost": {
      "type": "number",
      "default": 0,
      "description": "Gastos locales asignados a esta unidad"
    },
    "allocated_repair_cost": {
      "type": "number",
      "default": 0,
      "description": "Gastos de reparación asignados directamente a esta unidad"
    },
    "allocated_other_cost": {
      "type": "number",
      "default": 0,
      "description": "Otros costos asignados a esta unidad"
    },
    "total_real_unit_cost": {
      "type": "number",
      "default": 0,
      "description": "Costo real total consolidado. SOT del costo. Suma de todos los costos asignados."
    },
    "assigned_pricing_profile_id": {
      "type": "string",
      "description": "Override de perfil de precios específico para esta unidad"
    },
    "retail_price": {
      "type": "number",
      "default": 0,
      "description": "Precio retail calculado por PricingEngine. SOLO LECTURA."
    },
    "wholesale_price": {
      "type": "number",
      "default": 0,
      "description": "Precio mayorista calculado por PricingEngine. SOLO LECTURA."
    },
    "minimum_price": {
      "type": "number",
      "default": 0,
      "description": "Precio mínimo calculado por PricingEngine. SOLO LECTURA."
    },
    "margin_percent": {
      "type": "number",
      "default": 0,
      "description": "Margen % calculado por PricingEngine. SOLO LECTURA."
    },
    "product_definition_id": {
      "type": "string",
      "description": "[M1 Catálogo Satélite] Referencia opcional a ProductDefinition. No afecta motor de costos ni pricing."
    },
    "product_variant_id": {
      "type": "string",
      "description": "[M1 Catálogo Satélite] Referencia opcional a ProductVariant. No afecta motor de costos ni pricing."
    }
  },
  "required": [
    "category_key",
    "status",
    "total_real_unit_cost"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}
