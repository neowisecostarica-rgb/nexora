{
  "name": "InventoryUnits",
  "type": "object",
  "properties": {
    "serial_code_internal": {
      "type": "string"
    },
    "purchase_item_id": {
      "type": "string"
    },
    "import_batch_id": {
      "type": "string"
    },
    "brand": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "cpu_raw": {
      "type": "string",
      "description": "CPU tal como fue ingresado por el usuario"
    },
    "cpu_normalized": {
      "type": "string",
      "description": "CPU normalizado para agrupaci\u00f3n de cat\u00e1logo"
    },
    "ram_gb": {
      "type": "number"
    },
    "storage_type_raw": {
      "type": "string",
      "description": "Tipo de almacenamiento tal como fue ingresado"
    },
    "storage_type": {
      "type": "string",
      "enum": [
        "SSD",
        "HDD",
        "eMMC",
        "NVMe"
      ],
      "description": "Tipo de almacenamiento normalizado"
    },
    "storage_gb": {
      "type": "number"
    },
    "screen_size_raw": {
      "type": "string",
      "description": "Tama\u00f1o de pantalla tal como fue ingresado"
    },
    "screen_size_normalized": {
      "type": "string",
      "description": "Tama\u00f1o de pantalla normalizado (ej. 15.6)"
    },
    "form_factor": {
      "type": "string",
      "enum": [
        "clamshell",
        "2-in-1",
        "tablet",
        "rugged"
      ]
    },
    "condition_grade": {
      "type": "string",
      "enum": [
        "A+",
        "A",
        "B+",
        "B",
        "C",
        "D",
        "parts"
      ]
    },
    "cosmetic_notes": {
      "type": "string"
    },
    "technical_notes": {
      "type": "string"
    },
    "battery_notes": {
      "type": "string"
    },
    "charger_included": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "available",
        "reserved",
        "quoted",
        "sold",
        "warranty",
        "damaged",
        "in_repair",
        "discontinued"
      ],
      "default": "available",
      "description": "Estado oficial del ciclo de vida de la unidad"
    },
    "warehouse_location": {
      "type": "string"
    },
    "cost_purchase_unit": {
      "type": "number",
      "default": 0
    },
    "cost_import_unit": {
      "type": "number",
      "default": 0
    },
    "cost_repair_unit": {
      "type": "number",
      "default": 0
    },
    "cost_local_unit": {
      "type": "number",
      "default": 0
    },
    "total_real_unit_cost": {
      "type": "number",
      "default": 0,
      "description": "SOT: Costo real total consolidado de la unidad"
    },
    "cost_frozen_at_sale": {
      "type": "number",
      "default": 0,
      "description": "Costo congelado al momento de ser vendida. No se modifica despu\u00e9s."
    },
    "pricing_profile_id": {
      "type": "string"
    },
    "retail_price": {
      "type": "number",
      "default": 0,
      "description": "Cache del PricingEngine. SOLO LECTURA. No editar directamente."
    },
    "wholesale_price": {
      "type": "number",
      "default": 0,
      "description": "Cache del PricingEngine. SOLO LECTURA. No editar directamente."
    },
    "minimum_sale_price": {
      "type": "number",
      "default": 0,
      "description": "Cache del PricingEngine. SOLO LECTURA. No editar directamente."
    },
    "margin_percent": {
      "type": "number",
      "default": 0,
      "description": "Cache del PricingEngine. SOLO LECTURA. No editar directamente."
    },
    "pricing_calculated_at": {
      "type": "string",
      "description": "Timestamp del \u00faltimo c\u00e1lculo de precios"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de im\u00e1genes del producto"
    },
    "main_image": {
      "type": "string",
      "description": "URL de la imagen principal. Debe existir en images."
    },
    "received_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "brand",
    "model"
  ]
}