{
  "name": "Reservations",
  "type": "object",
  "properties": {
    "inventory_unit_id": {
      "type": "string",
      "description": "Referencia a la unidad de inventario reservada"
    },
    "customer_name": {
      "type": "string",
      "description": "Nombre del cliente"
    },
    "customer_phone": {
      "type": "string",
      "description": "Teléfono del cliente"
    },
    "customer_email": {
      "type": "string",
      "description": "Email del cliente (opcional)"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "reserved",
        "expired",
        "converted_to_sale",
        "cancelled"
      ],
      "default": "draft",
      "description": "Estado de la reserva"
    },
    "reserved_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora en que se activó la reserva"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de expiración de la reserva"
    },
    "required_deposit": {
      "type": "number",
      "description": "Monto de depósito requerido para activar la reserva"
    },
    "notes": {
      "type": "string",
      "description": "Notas adicionales sobre la reserva"
    },
    "sale_id": {
      "type": "string",
      "description": "ID de la venta resultante si fue convertida"
    },
    "organization_id": {
      "type": "string",
      "description": "ID de OrganizationProfile propietaria. Campo opcional durante transición; registros sin asignación requieren revisión, no inferir dueño."
    }
  },
  "required": [
    "inventory_unit_id",
    "customer_name",
    "customer_phone",
    "status"
  ]
}
