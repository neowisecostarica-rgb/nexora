{
  "name": "SaleItems",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string"
    },
    "inventory_unit_id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 1
    },
    "unit_sale_price": {
      "type": "number",
      "default": 0,
      "description": "Precio vendido. Congelado al momento de la venta."
    },
    "unit_cost": {
      "type": "number",
      "default": 0,
      "description": "Costo hist\u00f3rico congelado al momento de la venta (SOT para hist\u00f3rico)."
    },
    "unit_profit": {
      "type": "number",
      "default": 0,
      "description": "Utilidad real = unit_sale_price - unit_cost. Calculado y congelado."
    },
    "margin_percent_at_sale": {
      "type": "number",
      "default": 0,
      "description": "Margen % real al momento de la venta."
    },
    "line_total": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "sale_id",
    "description",
    "unit_sale_price"
  ]
}