{
  "name": "SaleItems",
  "type": "object",
  "properties": {
    "sale_id": {
      "type": "string",
      "description": "Referencia a la venta principal"
    },
    "inventory_unit_id": {
      "type": "string",
      "description": "Referencia a la unidad de inventario vendida"
    },
    "quantity": {
      "type": "number",
      "default": 1,
      "description": "Cantidad vendida (normalmente 1 por unidad serializada)"
    },
    "unit_price_sold": {
      "type": "number",
      "default": 0,
      "description": "Precio al que se vendi\u00f3 la unidad. Congelado al momento de la venta."
    },
    "unit_cost_frozen": {
      "type": "number",
      "default": 0,
      "description": "Costo real congelado desde InventoryUnits.real_unit_cost al momento de la venta. SOT hist\u00f3rico."
    },
    "line_total": {
      "type": "number",
      "default": 0,
      "description": "Total de la l\u00ednea (unit_price_sold \u00d7 quantity)"
    },
    "profit_amount": {
      "type": "number",
      "default": 0,
      "description": "Utilidad real = line_total - (unit_cost_frozen \u00d7 quantity). Congelado."
    }
  },
  "required": [
    "sale_id",
    "inventory_unit_id",
    "quantity",
    "unit_price_sold",
    "unit_cost_frozen"
  ]
}