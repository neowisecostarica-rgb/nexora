{
  "name": "PartnerAccessGrant",
  "type": "object",
  "properties": {
    "partner_organization_id": {
      "type": "string"
    },
    "client_organization_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ]
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "operations.read",
          "operations.write",
          "tracking.read",
          "tracking.write",
          "documents.read",
          "documents.write"
        ]
      }
    },
    "operation_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "partner_organization_id",
    "client_organization_id",
    "status",
    "permissions",
    "operation_ids"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}
