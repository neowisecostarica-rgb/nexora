{
  "name": "RecalculationQueue",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organización propietaria. Requerido para multi-tenancy."
    },
    "inventory_unit_id": {
      "type": "string",
      "description": "ID de la InventoryUnit pendiente de recálculo."
    },
    "trigger_source": {
      "type": "string",
      "description": "Nombre de la función o sistema que originó el encolado (ej. onInventoryUnitChanged, onImportBatchChanged)."
    },
    "trigger_entity_type": {
      "type": "string",
      "description": "Tipo de entidad que disparó el evento (ej. InventoryUnits, ImportBatches, Expenses). Opcional."
    },
    "trigger_entity_id": {
      "type": "string",
      "description": "ID de la entidad que disparó el evento. Opcional."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "done",
        "failed"
      ],
      "default": "pending",
      "description": "Estado del registro en la cola. pending = esperando ejecución, processing = en proceso, done = completado, failed = error."
    },
    "dedupe_key": {
      "type": "string",
      "description": "Clave de deduplicación. Formato: inventory_unit:{inventory_unit_id}. Garantiza una sola entrada activa por unidad."
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "Momento a partir del cual este registro puede ser procesado. Aplica ventana de debounce."
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de cuando fue procesado exitosamente."
    },
    "error_message": {
      "type": "string",
      "description": "Mensaje de error si status=failed."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Contexto adicional del encolado. Puede incluir resumen de resultado, notas de distribución, etc."
    }
  },
  "required": [
    "organization_id",
    "inventory_unit_id",
    "trigger_source",
    "status",
    "dedupe_key",
    "scheduled_for"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}
