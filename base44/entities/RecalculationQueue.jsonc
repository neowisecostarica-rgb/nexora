{
  "name": "RecalculationQueue",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "ID de la organizaci\u00f3n propietaria. Requerido para multi-tenancy."
    },
    "inventory_unit_id": {
      "type": "string",
      "description": "ID de la InventoryUnit pendiente de rec\u00e1lculo."
    },
    "trigger_source": {
      "type": "string",
      "description": "Nombre de la funci\u00f3n o sistema que origin\u00f3 el encolado (ej. onInventoryUnitChanged, onImportBatchChanged)."
    },
    "trigger_entity_type": {
      "type": "string",
      "description": "Tipo de entidad que dispar\u00f3 el evento (ej. InventoryUnits, ImportBatches, Expenses). Opcional."
    },
    "trigger_entity_id": {
      "type": "string",
      "description": "ID de la entidad que dispar\u00f3 el evento. Opcional."
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "done",
        "failed"
      ],
      "default": "pending",
      "description": "Estado del registro en la cola. pending = esperando ejecuci\u00f3n, processing = en proceso, done = completado, failed = error."
    },
    "dedupe_key": {
      "type": "string",
      "description": "Clave de deduplicaci\u00f3n. Formato: inventory_unit:{inventory_unit_id}. Garantiza una sola entrada activa por unidad."
    },
    "scheduled_for": {
      "type": "string",
      "format": "date-time",
      "description": "Momento a partir del cual este registro puede ser procesado. Aplica ventana de debounce."
    },
    "processed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de cuando fue procesado exitosamente."
    },
    "error_message": {
      "type": "string",
      "description": "Mensaje de error si status=failed."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Contexto adicional del encolado. Puede incluir resumen de resultado, notas de distribuci\u00f3n, etc."
    }
  },
  "required": [
    "organization_id",
    "inventory_unit_id",
    "trigger_source",
    "status",
    "dedupe_key",
    "scheduled_for"
  ]
}