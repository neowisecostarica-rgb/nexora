{
  "name": "Expenses",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "repair",
        "packaging",
        "courier",
        "advertising",
        "commission",
        "other"
      ]
    },
    "allocation_category": {
      "type": "string",
      "enum": [
        "repair",
        "local",
        "other"
      ],
      "description": "Categoría de asignación de costo. Solo 'repair' y 'local' afectan el costo real de unidades."
    },
    "linked_entity_type": {
      "type": "string"
    },
    "linked_entity_id": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "organization_id": {
      "type": "string",
      "description": "ID de OrganizationProfile propietaria. Campo opcional durante transición; registros sin asignación requieren revisión, no inferir dueño."
    }
  },
  "required": [
    "date",
    "category",
    "allocation_category",
    "amount"
  ]
}
