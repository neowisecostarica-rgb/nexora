{
  "name": "ProductDefinition",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "description": "Marca del producto (ej. Lenovo, Dell, HP)"
    },
    "model": {
      "type": "string",
      "description": "Modelo del producto (ej. ThinkPad X1 Carbon Gen 11)"
    },
    "category_key": {
      "type": "string",
      "description": "Categoría raíz del producto (ej. laptops, sneakers, smartphones)"
    },
    "product_family_code": {
      "type": "string",
      "description": "Código de familia/línea opcional (ej. ThinkPad, Latitude, EliteBook)"
    },
    "identity_hash": {
      "type": "string",
      "description": "Hash único de identidad: base64(BRAND|MODEL|CATEGORY). Garantiza unicidad y permite deduplicación exacta. NO modificar manualmente."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si false, este producto maestro es ignorado por el catálogo."
    },
    "notes": {
      "type": "string",
      "description": "Notas internas del administrador sobre esta definición."
    },
    "organization_id": {
      "type": "string",
      "description": "ID de OrganizationProfile propietaria. Campo opcional durante transición; registros sin asignación requieren revisión, no inferir dueño."
    }
  },
  "required": [
    "brand",
    "model",
    "category_key",
    "identity_hash"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__server_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__server_only__"
      }
    }
  }
}
