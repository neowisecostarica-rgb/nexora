{
  "name": "ProductDefinition",
  "type": "object",
  "properties": {
    "brand": {
      "type": "string",
      "description": "Marca del producto (ej. Lenovo, Dell, HP)"
    },
    "model": {
      "type": "string",
      "description": "Modelo del producto (ej. ThinkPad X1 Carbon Gen 11)"
    },
    "category_key": {
      "type": "string",
      "description": "Categor\u00eda ra\u00edz del producto (ej. laptops, sneakers, smartphones)"
    },
    "product_family_code": {
      "type": "string",
      "description": "C\u00f3digo de familia/l\u00ednea opcional (ej. ThinkPad, Latitude, EliteBook)"
    },
    "identity_hash": {
      "type": "string",
      "description": "Hash \u00fanico de identidad: base64(BRAND|MODEL|CATEGORY). Garantiza unicidad y permite deduplicaci\u00f3n exacta. NO modificar manualmente."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Si false, este producto maestro es ignorado por el cat\u00e1logo."
    },
    "notes": {
      "type": "string",
      "description": "Notas internas del administrador sobre esta definici\u00f3n."
    }
  },
  "required": [
    "brand",
    "model",
    "category_key",
    "identity_hash"
  ]
}