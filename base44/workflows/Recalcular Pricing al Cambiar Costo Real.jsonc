{
  "name": "Recalcular Pricing al Cambiar Costo Real",
  "description": "Automation obligatoria: cuando cambia cualquier campo de costo real en InventoryUnits, recalcula autom\u00e1ticamente los precios via calculateAndCachePricing para mantener SOT.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"real_unit_cost\") != null) or (.trigger.changed_fields | index(\"assigned_pricing_profile_id\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "InventoryUnits"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "recalcular_pricing_al_cambiar_costo_real",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "recalculatePricingOnCostChange",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "recalculatePricingOnCostChange"
  }
}